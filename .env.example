AUTH0_SECRET=
AUTH0_BASE_URL=
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
DATABASE_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAILGUN_USERNAME=
MAILGUN_PASSWORD=
CRON_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=

# Set to true locally so errors aren't reported to Sentry (see src/config/sentry.ts).
NEXT_PUBLIC_SENTRY_DISABLED=true

# Optional: use OpenRouter for the AI item features instead of Google directly.
# When set, it takes priority over GOOGLE_GENERATIVE_AI_API_KEY.
OPENROUTER_API_KEY=
# Optional: model override, e.g. google/gemini-3.8-flash (OpenRouter) or gemini-3.8-flash (Google).
AI_ITEM_MODEL=
# Optional: web lookup for "Identify with AI" from a title (OpenRouter only):
# exa (default), parallel, native or off.
AI_WEB_SEARCH=
# Optional: free TMDB key (v3 API key or v4 read token) for movie/TV posters in the image picker.
TMDB_API_KEY=
